{
  "name": "dsh-remote-agents",
  "version": "0.2.0",
  "bin": {
    "dsh-remote-agents-import": "./lib/import-cli.js"
  },
  "description": "Local and SSH agent fleet workbench for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/FrankieeW/dsh-remote-agents.git" },
  "homepage": "https://github.com/FrankieeW/dsh-remote-agents#readme",
  "bugs": { "url": "https://github.com/FrankieeW/dsh-remote-agents/issues" },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skill": "./lib/skill.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "npm test && npm run build",
    "prepack": "npm run build"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
