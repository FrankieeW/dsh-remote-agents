{
  "name": "dsh-remote-agents",
  "version": "0.5.0-alpha.3",
  "bin": {
    "dsh-remote-agents-import": "./lib/import-cli.js"
  },
  "description": "Local and SSH agent fleet workbench for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrankieeW/dsh-remote-agents.git"
  },
  "homepage": "https://github.com/FrankieeW/dsh-remote-agents#readme",
  "bugs": {
    "url": "https://github.com/FrankieeW/dsh-remote-agents/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skill": "./lib/skill.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/*.js",
    "lib/*.map",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "lib/native/**"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js test/chat/*.test.js test/core/*.test.js test/import/*.test.js",
    "check": "npm run build && npm test && npm run test:native",
    "prepack": "npm run build",
    "test:package": "node scripts/verify-package.mjs",
    "test:smoke": "DSH_FLEET_SMOKE=1 node --test test/native-tmux.test.js",
    "build:native": "node scripts/build-native.mjs",
    "test:native": "cargo test --manifest-path native/Cargo.toml --locked"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318"
  }
}
